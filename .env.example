# Copy to .env (or let ./setup.sh create it with fresh random secrets). Never commit .env.
# Every value below is a DUMMY. The defaults describe the original blueprint setup: the bundled containers, the
# kunciai + Osiris AI providers behind LiteLLM, Indonesian briefings. Most things can be changed later in the web
# dashboard without touching this file; only secrets read when a container starts live here.

TZ=Asia/Jakarta

# ---------------------------------------------------------------- where each part runs (./setup.sh writes these)
DB_MODE=bundled            # bundled | external   external: set DATABASE_URL_OWNER (and optionally DATABASE_URL_APP)
REDIS_MODE=bundled         # bundled | external   external: set REDIS_URL
S3_MODE=garage             # garage (a container, bucket and key made for you) | external | local (this machine's disk)
LITELLM_MODE=bundled       # bundled | external   external: set LITELLM_BASE_URL and LITELLM_MASTER_KEY
API_PORT=8000
WEB_PORT=3000
# DATABASE_URL_OWNER=postgresql+asyncpg://owner:password@db.example.com:5432/apa
# DATABASE_URL_APP=postgresql+asyncpg://apa_app:password@db.example.com:5432/apa   # runtime role without DELETE
# REDIS_URL=redis://redis.example.com:6379/0

# ---------------------------------------------------------------- Postgres (bundled mode)
# OWNER runs migrations; APP is the runtime role (no DELETE on ledger tables).
POSTGRES_DB=apa
POSTGRES_USER=apa_owner
POSTGRES_PASSWORD=change-me-owner
APP_DB_USER=apa_app
APP_DB_PASSWORD=change-me-app

# ---------------------------------------------------------------- the API key (web dashboard and Android app sign in with it)
INGEST_API_KEY=change-me-ingest
# INGEST_HMAC_SECRET=          # optional: when set, every ingest call must carry a fresh signature (same secret in the app)
# INGEST_RATE_PER_MIN=120      # call cap on the ingest API, 0 = off

# ---------------------------------------------------------------- AI providers behind LiteLLM (infra/litellm/config.yaml)
LITELLM_MASTER_KEY=change-me-litellm
LITELLM_BASE_URL=http://litellm:4000/v1
# The blueprint's two providers. Replace with your own, or leave them empty and add providers in the dashboard
# (AI Models page): any OpenAI-compatible address and key, with a model per role and per agent.
KUNCI_API_BASE=https://kunciai.id/v1
KUNCI_API_KEY=
OSIRIS_API_BASE=https://ai.osiris-code.com/v1
OSIRIS_API_KEY=
# Used by infra/litellm/config.example.yaml (the generic template, for a fresh install with your own provider):
# MY_API_BASE=https://api.example.com/v1
# MY_API_KEY=sk-example
LLM_MAX_CONCURRENCY=3          # calls in flight per process; providers throttle bursts
LLM_MAX_RPM=48                 # client-side calls per minute; 0 = off
DEBATE_QUORUM=3                # votes (of 5 debaters) needed before a transaction may be committed

# ---------------------------------------------------------------- Telegram (optional until you want the bot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=0            # your numeric Telegram id: the only account the bot obeys

# ---------------------------------------------------------------- receipt photo storage (also switchable in the dashboard)
EVIDENCE_BACKEND=local         # the dashboard's Storage page overrides this; S3_MODE above decides what deploy.sh starts
EVIDENCE_DIR=data/evidence
# S3: filled in for you in garage mode; fill in yourself in external mode (AWS, R2, MinIO, B2...)
MINIO_ENDPOINT=garage:3900     # host:port, no scheme
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET_EVIDENCE=evidence
MINIO_REGION=garage            # Garage: garage; AWS: e.g. us-east-1; empty if unknown
MINIO_SECURE=false             # true for https
ALBUM_SETTLE_SECONDS=3         # a receipt album is read once photos stop arriving for this long
MAX_ALBUM_IMAGES=4

# ---------------------------------------------------------------- the morning briefing
BRIEFING_WAKE_TIME=06:30       # when you wake; the briefing is prepared BRIEFING_LEAD_MINUTES before it
BRIEFING_LEAD_MINUTES=25
WEATHER_CITY=Jakarta           # until you choose a city or GPS in the app or dashboard
WEATHER_ENABLED=true
TTS_ENABLED=true
TTS_ENGINE=auto                # auto = Gemini when GEMINI_API_KEY is set, else Microsoft; or edge | gemini
TTS_VOICE=id-ID-GadisNeural
GEMINI_API_KEY=                # free key from aistudio.google.com/apikey (voice quality; text of the briefing goes to Google)
# GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts   # also selectable in the dashboard

# ---------------------------------------------------------------- optional extras (idle until set)
FIRECRAWL_API_KEY=             # web search for the /private companion (tried first); FIRECRAWL_URL for your own Firecrawl
BRAVE_API_KEY=                 # web search through Brave (tried second); with neither, Wikipedia only
NVD_API_KEY=                   # higher NVD rate limit for CVE polling (free from nvd.nist.gov)
PRICE_FEED_URL=                # JSON feed of staple prices: [{"code","region","date","price"}]
SHEETS_CREDENTIALS_FILE=/run/secrets/apa/sheets.json   # service-account JSON (put it in ./secrets/)
SHEETS_SPREADSHEET_ID=         # or paste the whole sheet link into SHEETS_URL
SHEETS_URL=
HUAWEI_CLIENT_ID=              # Huawei Health Kit (untested against the real service)
HUAWEI_CLIENT_SECRET=
SECRETS_KEY=                   # REQUIRED for the diary and the assistant's memory (setup.sh makes one). BACK IT UP: without it they cannot be read. Also encrypts OAuth tokens (python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
NOTIFICATION_LLM_PER_HOUR=30   # unrecognised bank notifications that may go to the model per hour
PHONE_SILENT_HOURS=2           # Telegram says so when the phone app has not checked in for this many hours

# Erase raw chat text older than this many days once the diary has captured it (0 = keep for ever)
CHAT_KEEP_DAYS=7

# YouTube liked videos and followed channels (optional): a Google Cloud OAuth client of type "TVs and Limited Input devices"
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# Caring check-ins in Telegram (short sleep, no meal, up late, caffeine, stress): at most 2 a day. false = off
CARE_CHECKINS=true

# The assistant starts a chat now and then (morning, midday, evening); it stops if you do not answer. false = off
COMPANION_CHATS=true
COMPANION_MAX_PER_DAY=3

# ./deploy.sh backup writes database dumps here (default ./backups); older than BACKUP_KEEP_DAYS are removed
# BACKUP_DIR=/mnt/hdd/apa-backups
# BACKUP_KEEP_DAYS=14
# BACKUP_REQUIRE_FILE=/mnt/hdd/.apa-backup-disk   (a marker file on the disk: no backup is written while the disk is not mounted)
